MERGE (n:Trip {id: "trip-1"}) SET n += {description_vie: "Hành trình chinh phục Đèo Mã Pí Lèng hùng vĩ, hẻm Tu Sản và những cung đèo ngoạn mục tại địa đầu Tổ quốc.", created_at: datetime("2026-10-26T04:19:38.729140700Z"), description: "Epic mountain pass ride conquering Ma Pi Leng Pass, Tu San Canyon, and the dramatic winding limestone passes of Northern Vietnam.", title: "Ha Giang Extreme Northern Loop", rider_badge_vie: "Bậc thầy Hà Giang", eat_drink_json: "[{\"name\":\"Phở Cụ Thành - Đồng Văn\",\"type\":\"Local Breakfast\",\"rating\":\"4.9 ⭐\",\"cost\":\"50,000 VND\"},{\"name\":\"Mã Pí Lèng Sunset Coffee\",\"type\":\"Viewpoint Rest\",\"rating\":\"4.8 ⭐\",\"cost\":\"40,000 VND\"}]", duration_vie: "3 Ngày, 2 Đêm", duration: "3 Days, 2 Nights", is_deleted: false, title_vie: "Cung đường phượt đỉnh cao Vòng cung Hà Giang", landmarks_json: "[{\"name\":\"Mã Pí Lèng Skywalk\",\"stopTime\":\"1.5 hrs\",\"fee\":\"Free\"},{\"name\":\"Cột cờ Lũng Cú\",\"stopTime\":\"2 hrs\",\"fee\":\"20,000 VND\"}]", updated_at: datetime("2026-10-26T04:19:38.729140700Z"), id: "trip-1", cover_image: "https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=800&q=80", total_cost_vnd: "4,200,000 VND", google_maps_url: "https://maps.app.goo.gl/MaPiLengPass", rider_badge: "Ha Giang Master", distance_km: 350, avg_velocity_kmh: 48, total_cost_usd: "$170 USD", lodging_json: "[{\"name\":\"Bụi Homestay Đồng Văn\",\"price\":\"250,000 VND/night\",\"status\":\"Verified\"},{\"name\":\"Mã Pí Lèng Ecolodge\",\"price\":\"750,000 VND/night\",\"status\":\"Scenic View\"}]", dates: "Nov 12 - Nov 14, 2026", destination_json: "{\"name\":\"Ma Pi Leng Pass, Ha Giang\",\"nameVie\":\"Đèo Mã Pí Lèng, Hà Giang\",\"latitude\":23.2386,\"longitude\":105.4194,\"address\":\"Đèo Mã Pí Lèng, Pải Lủng, Mèo Vạc, Hà Giang, Vietnam\",\"mapUrl\":\"https://maps.app.goo.gl/MaPiLengPass\"}", likes_count: 142, group_size: "4 / 6 Riders", comments_count: 28, rider_name: "Minh Việt ADV", bike_model: "Adventure Tourer 1200", max_velocity_kmh: 82, category: "popular", rider_avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80"};
MERGE (n:Trip {id: "trip-2"}) SET n += {description_vie: "Thử thách ôm cua Đèo Bảo Lộc và Đèo Prenn, ngắm bình minh trên đồi thông thơ mộng.", created_at: datetime("2026-10-26T04:19:38.817065400Z"), description: "Thrilling mountain curves via Bao Loc Pass and Prenn Pass with cool pine forest hairpins.", title: "Sai Gon to Da Lat - The Highland Rush", rider_badge_vie: "Chiến thần Cao nguyên", eat_drink_json: "[{\"name\":\"Cơm Niêu Thuận Kiều Bảo Lộc\",\"type\":\"Rest Stop Lunch\",\"rating\":\"4.7 ⭐\",\"cost\":\"120,000 VND\"},{\"name\":\"Quán Cafe Đỉnh Đèo Gió\",\"type\":\"Panoramic View\",\"rating\":\"4.8 ⭐\",\"cost\":\"45,000 VND\"}]", duration_vie: "2 Ngày, 1 Đêm", duration: "2 Days, 1 Night", is_deleted: false, title_vie: "Sài Gòn - Đà Lạt: Cung đèo sương mù Cao nguyên", landmarks_json: "[{\"name\":\"Đèo Bảo Lộc Hairpin Turns\",\"stopTime\":\"45 mins\",\"fee\":\"Free\"},{\"name\":\"Hồ Tuyền Lâm Sunset Point\",\"stopTime\":\"1 hr\",\"fee\":\"Free\"}]", updated_at: datetime("2026-10-26T04:19:38.817065400Z"), id: "trip-2", cover_image: "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=800&q=80", total_cost_vnd: "2,800,000 VND", google_maps_url: "https://maps.app.goo.gl/PrennPassDaLat", rider_badge: "Highland Legend", distance_km: 310, avg_velocity_kmh: 62, total_cost_usd: "$115 USD", lodging_json: "[{\"name\":\"The Wilder-nest Da Lat\",\"price\":\"600,000 VND/night\",\"status\":\"Pine Forest\"}]", dates: "Every Weekend", destination_json: "{\"name\":\"Prenn Pass, Da Lat\",\"nameVie\":\"Đèo Prenn, Đà Lạt\",\"latitude\":11.9056,\"longitude\":108.4412,\"address\":\"Đèo Prenn, Phường 3, TP. Đà Lạt, Lâm Đồng, Vietnam\",\"mapUrl\":\"https://maps.app.goo.gl/PrennPassDaLat\"}", likes_count: 230, group_size: "6 / 8 Riders", comments_count: 45, rider_name: "Lam Le", bike_model: "BMW S1000RR M-Package", max_velocity_kmh: 115, category: "popular", rider_avatar: "https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?auto=format&fit=crop&w=250&q=80"};
MERGE (n:Trip {id: "trip-3"}) SET n += {description_vie: "Cung đường ven biển đẹp bậc nhất thế giới, ôm trọn vịnh Lăng Cô và bán đảo Sơn Trà tuyệt đẹp.", created_at: datetime("2026-10-26T04:19:38.832012Z"), description: "Coastal roads winding between steep mountains and the Pacific Ocean. Top Gear voted this route one of the best coastal drives.", title: "National Highway 1 & Hai Van Pass Coastal Odyssey", rider_badge_vie: "Bậc thầy đường ven biển", eat_drink_json: "[{\"name\":\"Hải Sản Đầm Lập An Lăng Cô\",\"type\":\"Seafood Lunch\",\"rating\":\"4.8 ⭐\",\"cost\":\"250,000 VND\"},{\"name\":\"Cafe Đỉnh Hải Vân Quan\",\"type\":\"Cloud Viewpoint\",\"rating\":\"4.9 ⭐\",\"cost\":\"35,000 VND\"}]", duration_vie: "4 Ngày, 3 Đêm", duration: "4 Days, 3 Nights", is_deleted: false, title_vie: "Thiên hạ đệ nhất hùng quan - Đèo Hải Vân & Duyên hải miền Trung", landmarks_json: "[{\"name\":\"Di tích Hải Vân Quan\",\"stopTime\":\"1 hr\",\"fee\":\"Free\"},{\"name\":\"Cây Thông Cô Đơn\",\"stopTime\":\"30 mins\",\"fee\":\"Free\"}]", updated_at: datetime("2026-10-26T04:19:38.832012Z"), id: "trip-3", cover_image: "https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=800&q=80", total_cost_vnd: "5,500,000 VND", google_maps_url: "https://maps.app.goo.gl/HaiVanPass", rider_badge: "Coast Conqueror", distance_km: 420, avg_velocity_kmh: 68, total_cost_usd: "$220 USD", lodging_json: "[{\"name\":\"Lang Co Beach Resort\",\"price\":\"950,000 VND/night\",\"status\":\"Beachfront\"}]", dates: "Dec 05 - Dec 08, 2026", destination_json: "{\"name\":\"Hai Van Pass Summit\",\"nameVie\":\"Đỉnh Đèo Hải Vân\",\"latitude\":16.1953,\"longitude\":108.1322,\"address\":\"Hải Vân Quan, TT. Lăng Cô, Phú Lộc, Thừa Thiên Huế, Vietnam\",\"mapUrl\":\"https://maps.app.goo.gl/HaiVanPass\"}", likes_count: 185, group_size: "8 / 10 Riders", comments_count: 39, rider_name: "Alex \"Viper\" Mercer", bike_model: "Honda CB500X", max_velocity_kmh: 105, category: "nearby", rider_avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=250&q=80"};

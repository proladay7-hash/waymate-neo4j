MERGE (n:ShopGear {id: "gear-001"}) SET n += {id: "gear-001", name: "Akrapovič Racing Line Titanium Full System", brand: "Akrapovič", category: "EXHAUST", vehicleType: "BIKE", compatibleModels: "All Superbikes & Hypernaked (S1000RR, R1, MT-09, CBR1000RR-R, ZX-10R)", priceVnd: 38500000, hpGain: 8.5, torqueGain: 6.4, weightDeltaKg: -4.2, soundDb: 108, soundProfile: "akrapovic_titanium", colorHex: "#38BDF8", rarity: "LEGENDARY", description: "Full hydroformed titanium race headers with hexagonal carbon end-cap. Delivers deep resonant bass idle and crisp WSBK top-end scream.", descriptionVie: "Full cổ pô Titanium kết hợp lon pô Carbon lục giác Akrapovič chính hãng. Âm trầm ấm ở tua thấp và gào uy lực ở tua cao."};
MERGE (n:ShopGear {id: "gear-002"}) SET n += {id: "gear-002", name: "Akrapovič Slip-On Line Carbon Hexagonal", brand: "Akrapovič", category: "EXHAUST", vehicleType: "BIKE", compatibleModels: "Universal Sport & Naked Bikes (MT-03, R3, CB650R, CBR650R, Ninja 400/650)", priceVnd: 18900000, hpGain: 3.4, torqueGain: 2.8, weightDeltaKg: -2.1, soundDb: 104, soundProfile: "akrapovic_titanium", colorHex: "#0EA5E9", rarity: "EPIC", description: "Handcrafted carbon fiber muffler sleeve with removable dB killer. Sharpens throttle response and sheds 2.1kg.", descriptionVie: "Lon pô Akrapovič sợi Carbon dệt thủ công kèm tiêu âm tháo rời, giúp nhẹ xe và vặn ga nhạy hơn."};
